# Keep the build context to what the image actually needs.
# Note: examples/supply_sample IS included — the supply scenario reads those CSVs at runtime,
# and they are what makes the image work with no dataset configured.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.vscode/
.idea/

# Build-time only, never read at runtime: the published source tables (~44MB) and the full
# per-entity set derived from them (~31MB). The image serves examples/supply_sample; point
# LOKA_SUPPLY_DATA at a mounted volume to serve the full set instead.
examples/olist_raw/
examples/supply_full/
